<script>
const D=JSON.parse(document.getElementById('dataset').textContent),$=id=>document.getElementById(id);let sortKey='combined',sortDir=1;
const money=n=>n==null?'—':n.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});const pct=n=>(n*100).toFixed(1)+'%';
function vals(r){let h=$('horizon').value,s=$('scenario').value;if(h==='current')return{price:r.price_now,monthly:r.monthly_now,insurance:r.insurance_5y_now,combined:r.combined_now,trend:r.trend};let f=r.forecast[h][s];return{price:f.future_price,monthly:f.monthly_at_horizon,insurance:f.insurance_next_5y,combined:f.combined,trend:r.trend}}
function metricValue(r){let v=vals(r),m=$('metric').value;return m==='price'?v.price:m==='insurance'?v.insurance:m==='monthly'?v.monthly:v.combined}
function render(){let q=$('search').value.toLowerCase(),arr=D.rows.filter(r=>r.name.toLowerCase().includes(q));arr.sort((a,b)=>{let x=sortKey==='name'?a.name.toLowerCase():sortKey==='match'?a.insurance_match:sortKey==='trend'?a.trend:sortKey==='rank'?metricValue(a):sortKey==='price'?vals(a).price:sortKey==='monthly'?vals(a).monthly:sortKey==='insurance'?vals(a).insurance:metricValue(a);let y=sortKey==='name'?b.name.toLowerCase():sortKey==='match'?b.insurance_match:sortKey==='trend'?b.trend:sortKey==='rank'?metricValue(b):sortKey==='price'?vals(b).price:sortKey==='monthly'?vals(b).monthly:sortKey==='insurance'?vals(b).insurance:metricValue(b);return(x>y?1:x<y?-1:0)*sortDir});let ranked=[...arr].sort((a,b)=>metricValue(a)-metricValue(b));$('count').textContent=arr.length.toLocaleString();$('winner').textContent=ranked[0]?.name||'—';$('winnerCost').textContent=ranked[0]?money(metricValue(ranked[0])):'—';$('chartTitle').textContent=($('metric').selectedOptions[0].text)+' · top 12';let top=ranked.slice(0,12),max=Math.max(1,...top.map(metricValue));$('chart').innerHTML=top.map((r,i)=>`<div class="barrow"><div class="barlabel" title="${esc(r.name)}">${i+1}. ${esc(r.name)}</div><div class="track"><div class="bar" style="width:${Math.max(1,metricValue(r)/max*100)}%"></div></div><div class="barvalue">${money(metricValue(r))}</div></div>`).join('')||'<div class="empty">No matching vehicles.</div>';$('tableBody').innerHTML=arr.map((r,i)=>{let v=vals(r);return`<tr><td>${i+1}</td><td>${esc(r.name)}</td><td><span class="match">${esc(r.insurance_match)}</span></td><td>${money(v.price)}</td><td>${money(v.monthly)}</td><td>${money(v.insurance)}</td><td><b>${money(v.combined)}</b></td><td>${pct(v.trend)}</td></tr>`}).join('');let selected=$('vehicle').value;if(!arr.some(r=>r.name===selected))selected=arr[0]?.name||'';$('vehicle').innerHTML=arr.map(r=>`<option ${r.name===selected?'selected':''}>${esc(r.name)}</option>`).join('');showDetails()}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showDetails(){let r=D.rows.find(x=>x.name===$('vehicle').value);if(!r){$('details').innerHTML='';$('history').innerHTML='';return}let v=vals(r);$('details').innerHTML=`<p><b>${esc(r.name)}</b></p><p>Insurance match: ${esc(r.insurance_match)}</p><p>Estimated purchase price: <b>${money(v.price)}</b></p><p>Monthly insurance: <b>${money(v.monthly)}</b></p><p>Five-year insurance: <b>${money(v.insurance)}</b></p><p>Combined estimate: <b>${money(v.combined)}</b></p><p>Observed insurance trend: ${pct(r.trend)} per year</p><p>Latest insurance month in data: ${esc(r.latest_month)}</p>`;let pts=r.history.slice(-24),max=Math.max(1,...pts.map(p=>p.premium));$('history').innerHTML=pts.length?pts.map(p=>`<div style="display:grid;grid-template-columns:75px 1fr 68px;gap:7px;align-items:center;font-size:11px;margin:5px 0"><span>${esc(p.month)}</span><div class="track"><div class="bar" style="width:${p.premium/max*100}%"></div></div><span style="text-align:right">${money(p.premium)}</span></div>`).join(''):'<p class="match">No monthly history available.</p>'}
['horizon','scenario','metric','search'].forEach(id=>$(id).addEventListener(id==='search'?'input':'change',render));$('vehicle').addEventListener('change',showDetails);document.querySelectorAll('th[data-sort]').forEach(th=>th.addEventListener('click',()=>{let k=th.dataset.sort;if(sortKey===k)sortDir*=-1;else{sortKey=k;sortDir=1}render()}));
$('scenarioNotes').textContent=Object.entries(D.assumptions.scenarios).map(([k,v])=>`${k}: real used-car price change ${pct(v.real_used_market_change)}, insurance anchor ${pct(v.insurance_anchor)}.`).join('  ');$('dataStatus').textContent=`${D.matched_count} matched models · real source data`;$('sourceNote').textContent=`Price source: ${D.price_file} · model years used: ${D.price_years.join(', ')} · ${D.price_rows.toLocaleString()} source price rows. Insurance source: moto2.csv. This page contains data derived from both source files.`;render();
</script></body></html>
